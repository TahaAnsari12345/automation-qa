          "id": "e3wboXh1INJk5WOy",
          "name": "GitHub account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// 1. Grab the array of repos from the first (and only) incoming item\nconst repos = $input.first().json.items;\n\n// 2. Sort by stars (highest first) and keep only the top 5\nconst top5 = repos\n  .sort((a, b) => b.stargazers_count - a.stargazers_count)\n  .slice(0, 5);\n\n// 3. Keep only the fields we need, and wrap each in { json: ... }\nreturn top5.map((repo) => ({\n  json: {\n    name: repo.name,\n    full_name: repo.full_name,\n    owner: repo.owner.login,\n    stars: repo.stargazers_count,\n    url: repo.html_url,\n    description: repo.description || \"No description\",\n  },\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "6b3bb9b1-5928-4493-b4ba-2d14385d804e",
      "name": "Top 5 repos"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Data from the earlier \"Top 5 Repos\" node, for the matching item\nconst repo = $(\"Top 5 repos\").item.json;\n\nreturn {\n  json: {\n    ...repo, // keep name, stars, url, etc.\n    release_version: $json.tag_name, // add data from the release call\n    release_date: $json.published_at,\n  },\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "13e9a703-9ba1-40b6-a917-68f6ae516202",
