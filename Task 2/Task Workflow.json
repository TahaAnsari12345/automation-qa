    {
      "parameters": {
        "jsCode": "const repos = $input.all().map((i) => i.json);\n\n// Highest stars first\nrepos.sort((a, b) => b.stars - a.stars);\n\nconst lines = repos.map(\n  (r, i) =>\n    `${i + 1}. ${r.label} **${r.name}** (⭐ ${r.stars.toLocaleString()})\\n` +\n    `   ${r.description}\\n` +\n    `   Latest release: ${r.release_version} | ${r.url}`,\n);\n\nconst message = \"**Morning Brief: Top AI Repos**\\n\\n\" + lines.join(\"\\n\\n\");\n\nreturn [{ json: { message } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1808,
        0
